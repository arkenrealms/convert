include_guard(GLOBAL)
function(arken_add_conversion_offline_payment_checks)
    get_filename_component(owner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    include("${owner}/cmake/ArkenCdpNative.cmake")
    arken_configure_cdp_native()
    set(fixtures "${CMAKE_CURRENT_BINARY_DIR}/paid-fixtures")
    file(MAKE_DIRECTORY "${fixtures}")
    file(CHMOD "${fixtures}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
    foreach(pair "x402|x402_tests" "reconciliation|settlement_reconciliation_tests" "public-admission|public_admission_tests" "startup|startup_tests")
        string(REPLACE "|" ";" fields "${pair}")
        list(GET fields 0 name)
        list(GET fields 1 source)
        set(target "arken-conversion-${name}-tests")
        add_executable(${target} "${owner}/tests/${source}.cpp")
        target_compile_definitions(${target} PRIVATE ARKEN_CONVERT_OFFLINE_QUALIFICATION=1)
        target_link_libraries(${target} PRIVATE arken_file_conversion_service_v1 arken_cloudflare_local_io_v1)
        if(name STREQUAL "startup")
            add_test(NAME ConversionOffline.${name} COMMAND ${target} --write-fixtures "${fixtures}/provider-fixtures.json" "${fixtures}")
            set_tests_properties(ConversionOffline.${name} PROPERTIES DEPENDS ConversionOffline.provider)
        else()
            add_test(NAME ConversionOffline.${name} COMMAND ${target} --write-fixtures "${fixtures}")
        endif()
        add_test(NAME ConversionOffline.${name}Version COMMAND ${target} --version --invalid /not/a/state)
        set_tests_properties(ConversionOffline.${name} PROPERTIES TIMEOUT 30)
        set_tests_properties(ConversionOffline.${name}Version PROPERTIES TIMEOUT 5 PASS_REGULAR_EXPRESSION "^${target} r")
    endforeach()
    add_executable(arken-conversion-provider-fixtures
        "${owner}/tests/provider_fixture_main.cpp"
        "${owner}/tools/native/provider_tests.cpp"
        "${owner}/tools/native/provider_observe.cpp")
    target_link_libraries(arken-conversion-provider-fixtures PRIVATE
        arken_file_conversion_service_v1_cdp_native arken_cloudflare_local_io_v1 arken::external_openssl_3_crypto_v1)
    add_test(NAME ConversionOffline.provider COMMAND arken-conversion-provider-fixtures --write-fixtures "${fixtures}")
    add_test(NAME ConversionOffline.providerVersion COMMAND arken-conversion-provider-fixtures --invalid --version /not/a/state)
    set_tests_properties(ConversionOffline.provider PROPERTIES TIMEOUT 30)
    set_tests_properties(ConversionOffline.providerVersion PROPERTIES TIMEOUT 5 PASS_REGULAR_EXPRESSION "^arken-conversion-provider-fixtures-r6249")
endfunction()
