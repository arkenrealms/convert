include_guard(GLOBAL)
function(arken_configure_cdp_native)
  if(TARGET arken_file_conversion_service_v1_cdp_native)
    return()
  endif()
  if(NOT TARGET arken::external_openssl_3_crypto_v1 OR NOT TARGET arken_file_conversion_service_v1_cdp_provider)
    message(FATAL_ERROR "CDP native signing requires manifest-resolved OpenSSL and the owning CDP provider target")
  endif()
  add_library(arken_file_conversion_service_v1_cdp_native STATIC "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../platform/native/provider_signing.cpp")
  target_compile_features(arken_file_conversion_service_v1_cdp_native PUBLIC cxx_std_20)
  target_link_libraries(arken_file_conversion_service_v1_cdp_native PUBLIC arken_file_conversion_service_v1_cdp_provider PRIVATE arken::external_openssl_3_crypto_v1)
endfunction()
