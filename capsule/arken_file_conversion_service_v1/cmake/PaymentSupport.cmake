include_guard(GLOBAL)
get_filename_component(_arken_payment_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
foreach(dependency arken_file_conversion_contract_v1 arken_paid_operation_v1 arken_schema_cpp_v1_tool_json arken_digest_v1 arken_mcp_protocol_v1)
    if(NOT TARGET ${dependency})
        message(FATAL_ERROR "Payment support requires declared target ${dependency}")
    endif()
endforeach()

# One definition of the existing payment/provider targets, shared by conversion
# and result-only MCP services. Public types do not require conversion kernels.
function(_arken_payment_support_target target)
    set(sources)
    foreach(source IN LISTS ARGN)
        list(APPEND sources "${_arken_payment_root}/src/${source}")
    endforeach()
    add_library(${target} STATIC ${sources})
    target_compile_features(${target} PUBLIC cxx_std_20)
    target_include_directories(${target} PUBLIC "${_arken_payment_root}/..")
endfunction()

_arken_payment_support_target(arken_file_conversion_service_v1_cdp_endpoints provider_endpoints.cpp)
_arken_payment_support_target(arken_file_conversion_service_v1_cdp_provider provider_authorization.cpp provider_signing.cpp provider_packet.cpp)
target_link_libraries(arken_file_conversion_service_v1_cdp_provider PUBLIC arken_file_conversion_service_v1_cdp_endpoints PRIVATE arken_mcp_protocol_v1)
_arken_payment_support_target(arken_file_conversion_service_v1_payment_profiles payment_profile.cpp)
