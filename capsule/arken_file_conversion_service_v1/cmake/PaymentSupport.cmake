_arken_payment_support_target(arken_file_conversion_service_v1_payment_state payment.cpp payment_packet.cpp)
target_link_libraries(arken_file_conversion_service_v1_payment_state PUBLIC arken_paid_operation_v1 PRIVATE arken_file_conversion_contract_v1 arken_schema_cpp_v1_tool_json arken_digest_v1)
_arken_payment_support_target(arken_file_conversion_service_v1_settlement_observer settlement_reconciliation.cpp reconciliation_configuration.cpp rpc_evidence.cpp transfer_evidence.cpp)
