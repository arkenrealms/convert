cmake_minimum_required(VERSION 3.25)
foreach(required JOURNAL_PACKAGE PAYMENT_PROOF REPORT_PROOF MAXIMUM_FIXTURE OUTPUT)
 if(NOT DEFINED ${required} OR NOT IS_ABSOLUTE "${${required}}")
  message(FATAL_ERROR "Supply absolute ${required}")
 endif()
endforeach()
file(READ "${MAXIMUM_FIXTURE}/resource-fixture.json" maximum_fixture)
string(JSON maximum_schema GET "${maximum_fixture}" schema)
string(JSON maximum_bytes GET "${maximum_fixture}" inputBytes)
string(JSON maximum_hash GET "${maximum_fixture}" inputSha256)
file(SIZE "${MAXIMUM_FIXTURE}/maximum-input.png" actual_maximum_bytes)
if(NOT maximum_schema STREQUAL "arken.convert.resource-fixture.v1" OR NOT maximum_bytes EQUAL 8388608 OR NOT actual_maximum_bytes EQUAL maximum_bytes)
 message(FATAL_ERROR "Native maximum source fixture invalid")
endif()
if(EXISTS "${OUTPUT}")
 message(FATAL_ERROR "Resource package output must be new")
endif()
file(READ "${JOURNAL_PACKAGE}/candidate.json" candidate)
file(SHA256 "${JOURNAL_PACKAGE}/candidate.json" candidate_hash)
file(READ "${PAYMENT_PROOF}/proof.json" payment)
file(READ "${REPORT_PROOF}/proof.json" report)
foreach(proof payment report)
 string(JSON status GET "${${proof}}" status)
 string(JSON proved_candidate GET "${${proof}}" candidateSha256)
 if(NOT status STREQUAL "passed" OR NOT proved_candidate STREQUAL candidate_hash)
  message(FATAL_ERROR "Resource prerequisite proof differs from candidate")
 endif()
endforeach()
string(JSON schema GET "${candidate}" schema)
string(JSON paid GET "${candidate}" paidModuleSha256)
string(JSON configuration_hash GET "${candidate}" configurationSha256)
file(SHA256 "${JOURNAL_PACKAGE}/configuration.json" actual_configuration)
string(JSON count LENGTH "${candidate}" files)
if(NOT schema STREQUAL "arken.convert.journal-candidate.v1" OR NOT count EQUAL 20 OR
 NOT configuration_hash STREQUAL actual_configuration OR
 NOT paid STREQUAL "567512707e9f220282f820afbfaad85f4ea1d911264b381bd238b5df260648dc")
 message(FATAL_ERROR "Resource candidate identity invalid")
endif()
file(MAKE_DIRECTORY "${OUTPUT}")
file(CHMOD "${OUTPUT}" PERMISSIONS OWNER_READ OWNER_WRITE OWNER_EXECUTE)
set(identity "{}")
set(modules "(name=\"resource_profile.js\",esModule=embed \"resource_profile.js\")")
set(names resource_profile.js)
function(stage name input kind expected)
 if(NOT name MATCHES "^[A-Za-z0-9_.-]+$" OR name IN_LIST names OR IS_SYMLINK "${input}")
  message(FATAL_ERROR "Invalid resource member: ${name}")
 endif()
 file(SHA256 "${input}" hash)
 if(expected AND NOT hash STREQUAL expected)
  message(FATAL_ERROR "Resource member changed: ${name}")
 endif()
 file(COPY_FILE "${input}" "${OUTPUT}/${name}")
 file(SHA256 "${OUTPUT}/${name}" copied_hash)
 if(NOT copied_hash STREQUAL hash)
  message(FATAL_ERROR "Resource member changed during copy: ${name}")
 endif()
 file(CHMOD "${OUTPUT}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE)
 string(JSON identity SET "${identity}" "${name}" "\"${hash}\"")
 list(APPEND names "${name}")
 string(APPEND modules ",(name=\"${name}\",${kind}=embed \"${name}\")")
 set(identity "${identity}" PARENT_SCOPE)
 set(names "${names}" PARENT_SCOPE)
 set(modules "${modules}" PARENT_SCOPE)
endfunction()
math(EXPR last "${count}-1")
foreach(i RANGE 0 ${last})
 string(JSON name GET "${candidate}" files ${i} name)
 string(JSON expected GET "${candidate}" files ${i} sha256)
 string(JSON bytes GET "${candidate}" files ${i} bytes)
 file(SIZE "${JOURNAL_PACKAGE}/package/${name}" actual_bytes)
 if(NOT actual_bytes EQUAL bytes)
  message(FATAL_ERROR "Candidate resource size changed")
 endif()
 if(name MATCHES "[.]wasm$")
  set(kind wasm)
 elseif(name MATCHES "[.]js$")
  set(kind esModule)
 else()
  set(kind text)
 endif()
 stage("${name}" "${JOURNAL_PACKAGE}/package/${name}" "${kind}" "${expected}")
endforeach()
foreach(name startup-fixtures.json jpeg-input.png sandbox_worker.js r2_bucket_fixture.js)
 if(name STREQUAL "startup-fixtures.json")
  string(JSON hash GET "${payment}" startupFixtureSha256)
 elseif(name STREQUAL "jpeg-input.png")
  # The older payment receipt seals its native expected output, not PNG input.
  # Snapshot this input now; the actual native-output hash is checked at runtime.
  file(SHA256 "${PAYMENT_PROOF}/${name}" hash)
 else()
  string(JSON hash GET "${payment}" sourceHashes "${name}")
 endif()
 if(name MATCHES "[.]js$")
  set(kind esModule)
 elseif(name MATCHES "[.]png$")
  set(kind data)
 else()
  set(kind text)
 endif()
 stage("${name}" "${PAYMENT_PROOF}/${name}" "${kind}" "${hash}")
endforeach()
foreach(name payment-journal-access-fixtures.json payment-journal-actors.json)
 string(JSON hash GET "${report}" "${name}")
 stage("${name}" "${REPORT_PROOF}/${name}" text "${hash}")
endforeach()
foreach(name production_http_tests.js payment_journal_http.js)
 stage("${name}" "${CMAKE_CURRENT_LIST_DIR}/${name}" esModule "")
endforeach()
stage(report_subject.js "${CMAKE_CURRENT_LIST_DIR}/resource_report_subject.js" esModule "")
stage(report-configuration.json "${JOURNAL_PACKAGE}/configuration.json" text "${configuration_hash}")
stage(maximum-input.png "${MAXIMUM_FIXTURE}/maximum-input.png" data "${maximum_hash}")
stage(resource-fixture.json "${MAXIMUM_FIXTURE}/resource-fixture.json" text "")
file(COPY_FILE "${CMAKE_CURRENT_LIST_DIR}/resource_profile.js" "${OUTPUT}/resource_profile.js")
file(WRITE "${OUTPUT}/config.capnp" "using Workerd=import \"/workerd/workerd.capnp\";\nconst config:Workerd.Config=(services=[(name=\"convert-profile\",worker=(compatibilityDate=\"2026-09-11\",modules=[${modules}],bindings=[(name=\"LEDGER\",durableObjectNamespace=(className=\"Ledger\")),(name=\"PAYMENT_LEDGER\",durableObjectNamespace=(className=\"JournalLedger\")),(name=\"CONVERT_REPORT_CONFIGURATION\",text=embed \"report-configuration.json\")],durableObjectNamespaces=[(className=\"Ledger\",uniqueKey=\"convert-resource-paid\",enableSql=true),(className=\"JournalLedger\",uniqueKey=\"convert-resource-report\",enableSql=true)],durableObjectStorage=(localDisk=\"state\"))),(name=\"state\",disk=(path=\"unused-state\",writable=true)),(name=\"internet\",network=(allow=[]))],sockets=[(name=\"profile\",http=(),service=\"convert-profile\")]);\n")
file(WRITE "${OUTPUT}/recipe.json" [=[
{"schema":"arken.codecast.workerd-profile.v1","workerName":"convert-profile","nativeWasmInventory":true,"maximumAccountedBytes":100663296,
"steps":[{"id":"production","path":"/production"},{"id":"journal","path":"/journal"},{"id":"maximum","path":"/maximum"},{"id":"retained","path":"/retained"}],
"calibrationSteps":[{"id":"array","kind":"arrayBuffer","path":"/calibrate-array","expectedBackingIncrease":4194304},{"id":"wasm","kind":"wasm","path":"/calibrate-wasm","expectedBackingIncrease":8388608}]}
]=])
foreach(name resource_profile.js config.capnp recipe.json)
 file(SHA256 "${OUTPUT}/${name}" hash)
 string(JSON identity SET "${identity}" "${name}" "\"${hash}\"")
endforeach()
string(JSON identity SET "${identity}" releaseId "\"${candidate_hash}\"")
file(WRITE "${OUTPUT}/identity.json" "${identity}\n")
foreach(name resource_profile.js config.capnp recipe.json identity.json)
 file(CHMOD "${OUTPUT}/${name}" PERMISSIONS OWNER_READ OWNER_WRITE)
endforeach()
message(STATUS "Prepared exact Convert resource package: ${OUTPUT}")
