function(stage_conversion_source_package output)
 include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../../arken_paid_mcp_cloudflare_v1/cmake/SourcePackageAssets.cmake")
 arken_paid_mcp_source_package_assets(convert "${SOURCE_PACKAGE}" "${output}" modules)
 file(READ "${SOURCE_PACKAGE}/candidate.json" manifest)
 string(JSON main GET "${manifest}" mainModule)
 if(NOT main STREQUAL "journal_entry.js")
  message(FATAL_ERROR "Convert current-source journal entry required")
 endif()
 set(base_modules conversion.wasm runtime.js payment_ledger.js public_admission.js conversion-journal-report.wasm
  journal_worker.js journal_ledger.js journal_report_runtime.js report_runtime.js report_http_transport.js bounded_body.js)
 foreach(name IN LISTS base_modules)
  if(NOT name IN_LIST modules)
   message(FATAL_ERROR "Convert source package missing required module: ${name}")
  endif()
 endforeach()
 file(SHA256 "${REPORT_MODULE}" requested)
 file(SHA256 "${output}/conversion-journal-report.wasm" staged)
 if(NOT requested STREQUAL staged)
  message(FATAL_ERROR "Source package report module differs")
 endif()
 set(extra "")
 foreach(name IN LISTS modules)
  if(name IN_LIST base_modules)
   continue()
  endif()
  if(name MATCHES "[.]js$")
   set(type esModule)
  elseif(name MATCHES "[.]wasm$")
   set(type wasm)
  else()
   set(type text)
  endif()
  string(APPEND extra "(name=\"${name}\",${type}=embed \"${name}\"),\n")
 endforeach()
 file(COPY_FILE "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/source_journal_subject.js" "${output}/report_subject.js")
 file(SHA256 "${SOURCE_PACKAGE}/candidate.json" package_hash)
 string(JSON package_files GET "${manifest}" files)
 set(extra_modules "${extra}" PARENT_SCOPE)
 set(source_package_sha256 "${package_hash}" PARENT_SCOPE)
 set(source_package_files "${package_files}" PARENT_SCOPE)
endfunction()
