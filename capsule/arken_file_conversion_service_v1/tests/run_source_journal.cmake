cmake_minimum_required(VERSION 3.25)
foreach(required SOURCE_PACKAGE_TOOL SOURCE_ROOT WASM REPORT_MODULE PAYMENT_TESTS WORKERD OUTPUT)
 if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
  message(FATAL_ERROR "Supply exact ${required}")
 endif()
endforeach()
set(evidence_root "${OUTPUT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run "${evidence_root}/run-${run_id}")
file(MAKE_DIRECTORY "${run}")
execute_process(COMMAND "${SOURCE_PACKAGE_TOOL}" --invalid --version RESULT_VARIABLE status OUTPUT_VARIABLE version TIMEOUT 5)
if(NOT status EQUAL 0 OR NOT version MATCHES "^arken-convert-source-package-r6250")
 message(FATAL_ERROR "Incorrect Convert source-package owner")
endif()
set(SOURCE_PACKAGE "${run}/package")
execute_process(COMMAND "${SOURCE_PACKAGE_TOOL}" --source-package "${SOURCE_ROOT}" "${WASM}" "${REPORT_MODULE}" "${SOURCE_PACKAGE}"
 RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE error TIMEOUT 20)
file(WRITE "${run}/package.log" "${report}${error}")
if(NOT status EQUAL 0)
 message(FATAL_ERROR "Source package failed: ${error}")
endif()
set(OUTPUT "${run}/report")
include("${CMAKE_CURRENT_LIST_DIR}/run_payment_journal.cmake")
set(proof_output "${OUTPUT}")
# These are authority-boundary checks, not alternative qualification modes.
foreach(mode mixed predecessor)
 set(arguments "-DREPORT_MODULE=${REPORT_MODULE}" "-DPAYMENT_TESTS=${PAYMENT_TESTS}" "-DWORKERD=${WORKERD}"
  "-DFROZEN_PACKAGE=${SOURCE_PACKAGE}" "-DOUTPUT=${run}/rejected-${mode}")
 if(mode STREQUAL "mixed")
  list(APPEND arguments "-DSOURCE_PACKAGE=${SOURCE_PACKAGE}")
  set(expected "Choose current source or frozen predecessor authority")
 else()
  set(expected "Frozen Convert dependency changed: conversion.wasm")
 endif()
 execute_process(COMMAND "${CMAKE_COMMAND}" ${arguments} -P "${CMAKE_CURRENT_LIST_DIR}/run_payment_journal.cmake"
  RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE error TIMEOUT 20)
 file(WRITE "${run}/rejected-${mode}.log" "${report}${error}")
 if(status EQUAL 0 OR NOT error MATCHES "${expected}" OR EXISTS "${run}/rejected-${mode}/proof.json")
  message(FATAL_ERROR "Source package crossed ${mode} authority boundary: ${error}")
 endif()
endforeach()
file(READ "${proof_output}/proof.json" proof)
string(JSON proof SET "${proof}" sourceAuthorityChecks "{\"passed\":true,\"mixedRejected\":true,\"currentAsPredecessorRejected\":true}")
file(WRITE "${proof_output}/proof.json" "${proof}\n")
file(COPY_FILE "${SOURCE_PACKAGE}/source-inputs.txt" "${evidence_root}/source-inputs.txt")
file(COPY_FILE "${proof_output}/proof.json" "${evidence_root}/proof.json")
