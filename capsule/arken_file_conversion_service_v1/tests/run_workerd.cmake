foreach(required WASM WORKERD OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} required")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/prepare_workerd.cmake")
execute_process(COMMAND "${WORKERD}" --version RESULT_VARIABLE version_result
    OUTPUT_VARIABLE version TIMEOUT 5)
if(NOT version_result EQUAL 0 OR NOT version MATCHES "workerd 2026-09-11")
    message(FATAL_ERROR "Wrong Worker runtime: ${version}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/run_workerd_process.cmake")
run_conversion_workerd("${OUTPUT}/config.capnp" 20 result out error metrics)
file(WRITE "${OUTPUT}/process-metrics.json" "${metrics}\n")
file(WRITE "${OUTPUT}/workerd.log" "${out}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Worker proof failed: ${out}${error}")
endif()
# Evidence identifies the staged bytes actually consumed by Workerd, not a
# source path that could have changed while the isolated process was running.
file(SHA256 "${OUTPUT}/conversion.wasm" hash)
file(SHA256 "${OUTPUT}/payment-packets.json" packet_hash)
file(READ "${OUTPUT}/payment-packets.json" packet_json)
string(JSON packet_count LENGTH "${packet_json}")
set(proof "{\"status\":\"passed\",\"runtime\":\"workerd-2026-09-11\",\"moduleSha256\":\"${hash}\",\"paymentPackets\":${packet_count},\"paymentPacketsSha256\":\"${packet_hash}\",\"storage\":\"fixture\",\"network\":\"denied\"}")
foreach(module conversion.wasm runtime.js worker.js bounded_body.js public_admission.js)
    file(SHA256 "${OUTPUT}/${module}" module_hash)
    string(JSON proof SET "${proof}" "${module}" "\"${module_hash}\"")
endforeach()
file(WRITE "${OUTPUT}/proof.json" "${proof}\n")
message(STATUS "Worker MCP, image conversion, private artifacts and rejection checks passed")
