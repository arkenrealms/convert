foreach(required WASM WORKERD OUTPUT)
    if(NOT DEFINED ${required})
        message(FATAL_ERROR "${required} required")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/prepare_workerd.cmake")
execute_process(COMMAND "${WORKERD}" --version RESULT_VARIABLE version_result
    OUTPUT_VARIABLE version TIMEOUT 5)
if(NOT version_result EQUAL 0 OR NOT version MATCHES "workerd 2026-09-11")
    message(FATAL_ERROR "Wrong Worker runtime: ${version}")
endif()
execute_process(COMMAND "${WORKERD}" test "${OUTPUT}/config.capnp"
    RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE error TIMEOUT 20)
file(WRITE "${OUTPUT}/workerd.log" "${out}${error}")
if(NOT result EQUAL 0)
    message(FATAL_ERROR "Worker proof failed: ${out}${error}")
endif()
file(SHA256 "${WASM}" hash)
file(WRITE "${OUTPUT}/proof.json" "{\"status\":\"passed\",\"runtime\":\"workerd-2026-09-11\",\"moduleSha256\":\"${hash}\",\"storage\":\"fixture\",\"network\":\"denied\"}\n")
message(STATUS "Worker MCP, image conversion, private artifacts and rejection checks passed")
