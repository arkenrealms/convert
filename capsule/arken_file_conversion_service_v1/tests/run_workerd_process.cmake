include_guard(GLOBAL)
# OS process measurements are diagnostic evidence, not Cloudflare isolate
# accounting. The native workerd child remains the actual test runtime.
function(run_conversion_workerd config timeout result_out stdout_out stderr_out metrics_out)
    set(command "${WORKERD}" test "${config}")
    if(CMAKE_HOST_APPLE)
        list(PREPEND command /usr/bin/time -l -p)
    endif()
    execute_process(COMMAND ${command} RESULT_VARIABLE result
        OUTPUT_VARIABLE out ERROR_VARIABLE err TIMEOUT "${timeout}")
    set(metrics "{\"available\":false}")
    if(CMAKE_HOST_APPLE AND result EQUAL 0)
        string(REGEX MATCH "([0-9]+)[ \t]+maximum resident set size" peak "${err}")
        set(rss "${CMAKE_MATCH_1}")
        string(REGEX MATCH "user[ \t]+([0-9]+[.][0-9]+)" user_match "${err}")
        set(user "${CMAKE_MATCH_1}")
        string(REGEX MATCH "sys[ \t]+([0-9]+[.][0-9]+)" system_match "${err}")
        set(system "${CMAKE_MATCH_1}")
        if(NOT peak OR NOT user_match OR NOT system_match)
            message(FATAL_ERROR "Native workerd process measurement missing")
        endif()
        set(metrics "{\"available\":true,\"authority\":\"macos-native-time-rusage\",\"scope\":\"whole-workerd-process-including-runtime-and-test-fixtures\",\"peakResidentBytes\":${rss},\"userCpuSeconds\":${user},\"systemCpuSeconds\":${system},\"cloudflareIsolateMemoryProved\":false}")
    endif()
    set(${result_out} "${result}" PARENT_SCOPE)
    set(${stdout_out} "${out}" PARENT_SCOPE)
    set(${stderr_out} "${err}" PARENT_SCOPE)
    set(${metrics_out} "${metrics}" PARENT_SCOPE)
endfunction()
