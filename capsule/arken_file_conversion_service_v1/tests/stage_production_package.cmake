# Build/proof input fence only; Cloudflare transaction authority remains in the
# native client. This never edits the frozen deployment or reads secret values.
function(stage_conversion_production_package destination)
  if(NOT STAGED_STATE)
    return()
  endif()
  if(NOT STAGE_PLAN_SHA256 MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "CONVERSION_STAGE_PLAN_SHA256 is required")
  endif()
  file(SHA256 "${STAGED_STATE}/frozen-plan.json" plan_hash)
  if(NOT plan_hash STREQUAL STAGE_PLAN_SHA256)
    message(FATAL_ERROR "Frozen conversion stage plan changed")
  endif()
  file(READ "${STAGED_STATE}/frozen-plan.json" plan)
  file(READ "${STAGED_STATE}/staged.json" receipt)
  string(JSON schema GET "${plan}" schema)
  string(JSON receipt_schema GET "${receipt}" schema)
  string(JSON receipt_plan GET "${receipt}" planSha256)
  string(JSON package_hash GET "${plan}" packageSha256)
  string(JSON receipt_package GET "${receipt}" packageSha256)
  if(NOT schema STREQUAL "arken.cloudflare.observed-worker-stage.v1" OR
     NOT receipt_schema STREQUAL "arken.cloudflare.observed-worker-stage-receipt.v1" OR
     NOT receipt_plan STREQUAL plan_hash OR NOT receipt_package STREQUAL package_hash)
    message(FATAL_ERROR "Conversion stage receipt identity mismatch")
  endif()
  set(expected NOTICE.txt bounded_body.js cdp_authorization.js conversion.wasm paid_conversion.js payment_ledger.js production_startup.js production_worker.js public_admission.js runtime.js settlement_reconciliation.js worker.js x402_facilitator.js)
  string(JSON count LENGTH "${plan}" files)
  list(LENGTH expected expected_count)
  if(NOT count EQUAL expected_count)
    message(FATAL_ERROR "Unexpected conversion production module count")
  endif()
  set(seen)
  set(hashes "{}")
  math(EXPR last "${count}-1")
  foreach(index RANGE 0 ${last})
    string(JSON name GET "${plan}" files ${index} name)
    if(NOT name IN_LIST expected OR name IN_LIST seen)
      message(FATAL_ERROR "Unexpected or duplicate conversion production module")
    endif()
    list(APPEND seen "${name}")
    string(JSON expected_hash GET "${plan}" files ${index} sha256)
    string(JSON expected_bytes GET "${plan}" files ${index} bytes)
    file(SHA256 "${STAGED_STATE}/package/${name}" hash)
    file(SIZE "${STAGED_STATE}/package/${name}" bytes)
    if(NOT hash STREQUAL expected_hash OR NOT bytes EQUAL expected_bytes)
      message(FATAL_ERROR "Frozen conversion production module changed: ${name}")
    endif()
    file(COPY_FILE "${STAGED_STATE}/package/${name}" "${destination}/${name}")
    file(SHA256 "${destination}/${name}" copied_hash)
    if(NOT copied_hash STREQUAL expected_hash)
      message(FATAL_ERROR "Conversion production copy identity mismatch: ${name}")
    endif()
    string(JSON hashes SET "${hashes}" "${name}" "\"${copied_hash}\"")
  endforeach()
  file(SHA256 "${WASM}" wasm_hash)
  string(JSON staged_wasm GET "${hashes}" conversion.wasm)
  if(NOT wasm_hash STREQUAL staged_wasm)
    message(FATAL_ERROR "CONVERSION_WASM differs from the staged production package")
  endif()
  set(production_package_hashes "${hashes}" PARENT_SCOPE)
  set(production_package_sha256 "${package_hash}" PARENT_SCOPE)
  set(production_stage_plan_sha256 "${plan_hash}" PARENT_SCOPE)
endfunction()
