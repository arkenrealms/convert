cmake_minimum_required(VERSION 3.25)
foreach(required SOURCE_PACKAGE_TOOL SOURCE_ROOT WASM REPORT_MODULE WORKERD OUTPUT)
 if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
  message(FATAL_ERROR "Supply exact ${required}")
 endif()
endforeach()
file(MAKE_DIRECTORY "${OUTPUT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef run_id)
set(run "${OUTPUT}/run-${run_id}")
execute_process(COMMAND "${SOURCE_PACKAGE_TOOL}" --invalid --version RESULT_VARIABLE status OUTPUT_VARIABLE version TIMEOUT 5)
if(NOT status EQUAL 0 OR NOT version MATCHES "^arken-convert-source-package-r6251")
 message(FATAL_ERROR "Incorrect source guard tool")
endif()
execute_process(COMMAND "${SOURCE_PACKAGE_TOOL}" --qualify-source-guard "${SOURCE_ROOT}" "${WASM}" "${REPORT_MODULE}" "${WORKERD}" "${run}"
 RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE error TIMEOUT 90)
file(WRITE "${OUTPUT}/${run_id}.log" "${report}${error}")
if(NOT status EQUAL 0)
 message(FATAL_ERROR "Source guard failed: ${error}; see ${run}")
endif()
file(COPY_FILE "${run}/source-inputs.txt" "${OUTPUT}/source-inputs.txt")
file(COPY_FILE "${run}/guard/proof.json" "${OUTPUT}/proof.json")
