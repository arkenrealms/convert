include_guard(GLOBAL)
if(NOT UNIX OR ARKEN_BROWSER_CPP OR EMSCRIPTEN)
 message(FATAL_ERROR "Native file capabilities require a POSIX host")
endif()
get_filename_component(owner "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
add_library(arken_file_workspace_files_v1 STATIC "${owner}/platform/native/files.cpp")
target_compile_features(arken_file_workspace_files_v1 PUBLIC cxx_std_20)
target_include_directories(arken_file_workspace_files_v1 PUBLIC "${owner}/include")
target_compile_options(arken_file_workspace_files_v1 PRIVATE -Wall -Wextra -Wpedantic -Werror)
function(arken_add_native_files_checks)
 add_executable(arken-native-files-tests "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/native_files_tests.cpp")
 target_link_libraries(arken-native-files-tests PRIVATE arken_file_workspace_files_v1)
 add_test(NAME NativeFiles.Contracts COMMAND arken-native-files-tests "${CMAKE_CURRENT_BINARY_DIR}/file-proof")
 add_test(NAME NativeFiles.Version COMMAND arken-native-files-tests --invalid --version)
 set_tests_properties(NativeFiles.Contracts PROPERTIES TIMEOUT 15)
 set_tests_properties(NativeFiles.Version PROPERTIES TIMEOUT 5 PASS_REGULAR_EXPRESSION "r6262")
endfunction()
