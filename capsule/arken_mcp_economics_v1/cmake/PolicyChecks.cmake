include_guard(GLOBAL)
function(arken_add_mcp_economics_checks)
 get_filename_component(owner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
 add_executable(arken-mcp-economics-tests "${owner}/tests/economics.cpp" "${owner}/tests/pricing.cpp" "${owner}/tests/budget_protocol.cpp")
 target_link_libraries(arken-mcp-economics-tests PRIVATE arken_mcp_economics_protocol_v1 arken_schema_cpp_v1_tool_json)
 add_test(NAME McpEconomics.FinancialInvariants COMMAND arken-mcp-economics-tests)
 add_test(NAME McpEconomics.Version COMMAND arken-mcp-economics-tests --invalid --version)
 set_tests_properties(McpEconomics.FinancialInvariants PROPERTIES TIMEOUT 30)
 set_tests_properties(McpEconomics.Version PROPERTIES TIMEOUT 5 PASS_REGULAR_EXPRESSION "r5825")
endfunction()
