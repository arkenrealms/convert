include_guard(GLOBAL)
if(NOT APPLE)
 message(FATAL_ERROR "The native Workerd profiler currently requires macOS")
endif()
if(NOT CMAKE_OBJCXX_COMPILE_OBJECT)
 message(FATAL_ERROR "Enable Objective-C++ at the native composition root before resolving the profiler component")
endif()
get_filename_component(owner "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET arken_codecast_cdp_session)
 add_library(arken_codecast_cdp_session STATIC "${owner}/tools/native/cdp_page_session.mm" "${owner}/tools/native/heap_wasm_inventory.cpp")
 target_compile_features(arken_codecast_cdp_session PUBLIC cxx_std_20)
 target_include_directories(arken_codecast_cdp_session PUBLIC "${owner}/tools/native")
 target_compile_options(arken_codecast_cdp_session PRIVATE -fobjc-arc -fblocks -Wall -Wextra -Werror)
 target_link_libraries(arken_codecast_cdp_session PUBLIC nlohmann_json::nlohmann_json "-framework Foundation")
endif()
add_executable(arken-codecast-workerd-profile "${owner}/tools/native/workerd_profile_main.mm" "${owner}/tools/native/workerd_profile.mm")
target_compile_options(arken-codecast-workerd-profile PRIVATE -fobjc-arc -fblocks -Wall -Wextra -Werror)
target_link_libraries(arken-codecast-workerd-profile PRIVATE arken_codecast_cdp_session arken::digest_v1)
