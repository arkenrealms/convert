include_guard(GLOBAL)
get_filename_component(_guard_owner "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET arken_cloudflare_qualification_v1 OR NOT TARGET arken_mcp_family_inventory_v1)
    message(FATAL_ERROR "Attempt guard requires declared native qualification and family inventory targets")
endif()
add_library(arken_mcp_attempt_guard_v1 STATIC
    "${_guard_owner}/src/guard_composition.cpp"
    "${_guard_owner}/src/guard_execution.cpp"
    "${_guard_owner}/src/source_guard.cpp")
target_sources(arken_mcp_attempt_guard_v1 PRIVATE "${_guard_owner}/src/resource_builder.cpp")
target_include_directories(arken_mcp_attempt_guard_v1 PUBLIC "${_guard_owner}/..")
target_compile_features(arken_mcp_attempt_guard_v1 PUBLIC cxx_std_20)
target_compile_options(arken_mcp_attempt_guard_v1 PRIVATE -Wall -Wextra -Wpedantic -Werror)
target_link_libraries(arken_mcp_attempt_guard_v1 PUBLIC arken_cloudflare_qualification_v1 PRIVATE arken_mcp_family_inventory_v1 arken_mcp_economics_v1)
function(arken_add_source_guard_checks)
 get_filename_component(owner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
 add_executable(arken-mcp-source-guard-tests "${owner}/tests/source_guard.cpp")
 target_link_libraries(arken-mcp-source-guard-tests PRIVATE arken_mcp_attempt_guard_v1)
 add_test(NAME McpSourceGuard.Contracts COMMAND arken-mcp-source-guard-tests)
 add_test(NAME McpSourceGuard.Version COMMAND arken-mcp-source-guard-tests --invalid --version)
 set_tests_properties(McpSourceGuard.Contracts PROPERTIES TIMEOUT 10)
 set_tests_properties(McpSourceGuard.Version PROPERTIES TIMEOUT 5 PASS_REGULAR_EXPRESSION "r6251")
endfunction()
