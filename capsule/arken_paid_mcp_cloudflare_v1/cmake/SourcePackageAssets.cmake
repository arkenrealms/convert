# Local conformance only. Production release/predecessor readers retain their
# own schemas and never accept this artifact as deployment evidence.
function(arken_paid_mcp_source_package_assets family package output result)
 if(IS_SYMLINK "${package}" OR IS_SYMLINK "${package}/candidate.json")
  message(FATAL_ERROR "Physical source package required")
 endif()
 file(READ "${package}/candidate.json" manifest)
 string(JSON schema GET "${manifest}" schema)
 string(JSON status GET "${manifest}" status)
 string(JSON scope GET "${manifest}" scope)
 string(JSON declared GET "${manifest}" family)
 if(NOT schema STREQUAL "arken.paid-mcp.source-package.v1" OR NOT status STREQUAL "prepared"
    OR NOT scope STREQUAL "local-qualification-only" OR NOT declared STREQUAL family)
  message(FATAL_ERROR "Exact local ${family} source package required")
 endif()
 foreach(field deploymentAuthorized runtimeQualified)
  string(JSON type TYPE "${manifest}" ${field})
  string(JSON value GET "${manifest}" ${field})
  if(NOT type STREQUAL "BOOLEAN" OR value)
   message(FATAL_ERROR "Source package must not claim runtime or deployment authority")
  endif()
 endforeach()
 string(JSON count LENGTH "${manifest}" files)
 if(count LESS 1 OR count GREATER 32)
  message(FATAL_ERROR "Source package module count invalid")
 endif()
 math(EXPR last "${count}-1")
 set(modules)
 foreach(index RANGE 0 ${last})
  string(JSON name GET "${manifest}" files ${index} name)
  string(JSON expected GET "${manifest}" files ${index} sha256)
  string(JSON bytes GET "${manifest}" files ${index} bytes)
  string(JSON media GET "${manifest}" files ${index} mediaType)
  if(NOT name MATCHES "^[a-zA-Z0-9_-][a-zA-Z0-9_.-]*$" OR name IN_LIST modules
      OR IS_SYMLINK "${package}/${name}" OR IS_DIRECTORY "${package}/${name}")
   message(FATAL_ERROR "Unsafe source package member")
  endif()
  if(NOT ((name MATCHES "\\.js$" AND media STREQUAL "application/javascript+module")
       OR (name MATCHES "\\.wasm$" AND media STREQUAL "application/wasm")
       OR (name MATCHES "\\.txt$" AND media STREQUAL "text/plain")))
   message(FATAL_ERROR "Source package media type differs")
  endif()
  file(SHA256 "${package}/${name}" actual)
  file(SIZE "${package}/${name}" actual_bytes)
  if(NOT actual STREQUAL expected OR NOT actual_bytes EQUAL bytes)
   message(FATAL_ERROR "Source package member changed: ${name}")
  endif()
  file(COPY_FILE "${package}/${name}" "${output}/${name}")
  file(SHA256 "${output}/${name}" copied)
  if(NOT copied STREQUAL expected)
   message(FATAL_ERROR "Copied source package member differs: ${name}")
  endif()
  list(APPEND modules "${name}")
 endforeach()
 string(JSON main GET "${manifest}" mainModule)
 if(NOT main IN_LIST modules)
  message(FATAL_ERROR "Source package entrypoint missing")
 endif()
 set(${result} "${modules}" PARENT_SCOPE)
endfunction()
