include_guard(GLOBAL)
get_filename_component(_paid_source_owner "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
include("${_paid_source_owner}/cmake/SourcePackageAssets.cmake")
if(NOT TARGET arken_cloudflare_local_io_v1)
    message(FATAL_ERROR "Source packages require the declared Cloudflare local I/O component")
endif()
add_library(arken_paid_mcp_source_package_v1 STATIC "${_paid_source_owner}/src/source_package_files.cpp")
target_compile_features(arken_paid_mcp_source_package_v1 PUBLIC cxx_std_20)
target_include_directories(arken_paid_mcp_source_package_v1 PUBLIC "${_paid_source_owner}/..")
target_link_libraries(arken_paid_mcp_source_package_v1 PUBLIC arken_cloudflare_local_io_v1)
target_compile_options(arken_paid_mcp_source_package_v1 PRIVATE -Wall -Wextra -Wpedantic -Werror)

function(arken_add_source_package_checks)
    get_filename_component(owner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    add_executable(arken-paid-source-package-tests "${owner}/tests/source_package_files.cpp")
    target_link_libraries(arken-paid-source-package-tests PRIVATE arken_paid_mcp_source_package_v1)
    add_test(NAME PaidSourcePackage.Files COMMAND arken-paid-source-package-tests "${CMAKE_CURRENT_BINARY_DIR}/source-package-checks")
    add_test(NAME PaidSourcePackage.Version COMMAND arken-paid-source-package-tests --invalid --version /not/a/path)
    set_tests_properties(PaidSourcePackage.Files PROPERTIES TIMEOUT 10)
    set_tests_properties(PaidSourcePackage.Version PROPERTIES TIMEOUT 5 PASS_REGULAR_EXPRESSION "^arken-paid-source-package-tests-r6250")
endfunction()
