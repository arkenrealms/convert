cmake_minimum_required(VERSION 3.25)
file(MAKE_DIRECTORY "${OUTPUT}")
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef id)
set(run "${OUTPUT}/${id}")
execute_process(COMMAND "${FIXTURES}" --prepare "${run}" RESULT_VARIABLE result
 OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "Fixture preparation: ${log}${error}")
endif()
file(WRITE "${run}/preparation.log" "${log}${error}")
execute_process(COMMAND "${SERVER}" --stdio --root "${run}/files" INPUT_FILE "${run}/requests.jsonl"
 OUTPUT_FILE "${run}/actual.jsonl" ERROR_FILE "${run}/stderr.log" RESULT_VARIABLE result TIMEOUT 30)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "MCP subprocess failed: ${result}; ${run}/stderr.log")
endif()
file(SIZE "${run}/stderr.log" diagnostics)
if(NOT diagnostics EQUAL 0)
 message(FATAL_ERROR "Unexpected diagnostics: ${run}/stderr.log")
endif()
execute_process(COMMAND "${FIXTURES}" --verify "${run}" RESULT_VARIABLE result
 OUTPUT_VARIABLE log ERROR_VARIABLE error TIMEOUT 30)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "MCP verification: ${log}${error}")
endif()
file(WRITE "${run}/verified.log" "${log}${error}")
message(STATUS "${log}")
