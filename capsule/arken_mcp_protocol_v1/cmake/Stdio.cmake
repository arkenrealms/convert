include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/Rpc.cmake")
if(ARKEN_BROWSER_CPP OR EMSCRIPTEN)
    message(FATAL_ERROR "MCP stdio requires a native process")
endif()
add_library(arken_mcp_stdio_v1 STATIC EXCLUDE_FROM_ALL "${CMAKE_CURRENT_LIST_DIR}/../platform/native/stdio.cpp")
target_compile_features(arken_mcp_stdio_v1 PUBLIC cxx_std_20)
target_link_libraries(arken_mcp_stdio_v1 PUBLIC arken_mcp_protocol_v1)
target_compile_options(arken_mcp_stdio_v1 PRIVATE -Wall -Wextra -Wpedantic -Werror)
function(arken_add_mcp_stdio_checks)
    add_executable(arken-mcp-stdio-tests "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../tests/stdio.cpp")
    target_link_libraries(arken-mcp-stdio-tests PRIVATE arken_mcp_stdio_v1)
    add_test(NAME McpStdio.Framing COMMAND arken-mcp-stdio-tests)
    add_test(NAME McpStdio.Version COMMAND arken-mcp-stdio-tests --invalid --version)
    set_tests_properties(McpStdio.Framing PROPERTIES TIMEOUT 5)
    set_tests_properties(McpStdio.Version PROPERTIES TIMEOUT 5 PASS_REGULAR_EXPRESSION "^arken-mcp-stdio-tests-r6258")
endfunction()
