cmake_minimum_required(VERSION 3.25)
foreach(required ORIGIN WASM SOURCE REFERENCE OUTPUT)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
if(NOT ORIGIN MATCHES "^http://(127[.]0[.]0[.]1|localhost):[0-9]+$" OR NOT IS_ABSOLUTE "${OUTPUT}" OR EXISTS "${OUTPUT}")
  message(FATAL_ERROR "Use the existing local product origin and a fresh absolute recipe path")
endif()
file(READ "${REFERENCE}" reference)
string(JSON status GET "${reference}" status)
if(NOT status STREQUAL passed)
  message(FATAL_ERROR "Native HEIF sample did not decode")
endif()
string(JSON EXPECTED_WIDTH GET "${reference}" width)
string(JSON EXPECTED_HEIGHT GET "${reference}" height)
string(JSON EXPECTED_PIXELS GET "${reference}" rgbaFnv1a64)
file(SHA256 "${WASM}" WASM_SHA)
file(SHA256 "${SOURCE}" SOURCE_SHA)
configure_file("${CMAKE_CURRENT_LIST_DIR}/browser.json.in" "${OUTPUT}" @ONLY)
