{
 "schema":"arken.codecast.native-browser-proof.v1",
 "url":"@ORIGIN@/assets/convert-public/preview.html?theme=dark",
 "width":2500,"height":1400,"captureConsole":true,"captureNetwork":true,
 "memoryBudget":{"maximumPhysicalFootprintBytes":4000000000},
 "steps":[
  {"id":"heif-page-ready","waitFor":"document.readyState==='complete'","timeoutMs":30000},
  {"id":"heif-native-wasm-parity","evaluate":"(async()=>{const {cppProgramImports,CPP_PROGRAM_IMPORTS}=await import('/capsules/arken_live_machine_v1/browser/live_cpp_program_imports.js');const root='/capsules/arken_image_codecs_v1/qualification/';const fetchBytes=async name=>{const r=await fetch(root+name);if(!r.ok)throw Error(name+' HTTP '+r.status);return new Uint8Array(await r.arrayBuffer());};const wasm=await fetchBytes('heif-dependencies.wasm');const sha=async bytes=>Array.from(new Uint8Array(await crypto.subtle.digest('SHA-256',bytes)),v=>v.toString(16).padStart(2,'0')).join('');if(await sha(wasm)!=='@WASM_SHA@')throw Error('Wrong qualification module');const module=await WebAssembly.compile(wasm),imports=WebAssembly.Module.imports(module);if(imports.some(i=>!CPP_PROGRAM_IMPORTS.includes(i.module+'.'+i.name+':'+i.kind)||i.kind!=='function'))throw Error('Unexpected dependency imports: '+JSON.stringify(imports));let instance;const memoryView={get buffer(){if(!instance)throw Error('Memory used before initialization');return instance.exports.memory.buffer;}};instance=await WebAssembly.instantiate(module,cppProgramImports(memoryView));instance.exports.__wasm_call_ctors();const admission=instance.exports.arken_heif_dependency_check();if(admission!==0)throw Error('HEIF admission '+admission);const source=await fetchBytes('example.heic');if(await sha(source)!=='@SOURCE_SHA@')throw Error('Wrong HEIF sample');const ptr=instance.exports.malloc(source.length);if(!ptr)throw Error('Input allocation failed');let result;try{new Uint8Array(instance.exports.memory.buffer,ptr,source.length).set(source);const started=performance.now(),code=instance.exports.arken_heif_dependency_decode(ptr,source.length);result={code,width:instance.exports.arken_heif_dependency_width(),height:instance.exports.arken_heif_dependency_height(),rgbaFnv1a64:BigInt.asUintN(64,instance.exports.arken_heif_dependency_pixels()).toString(16).padStart(16,'0'),milliseconds:performance.now()-started};if(code!==0||result.width!==@EXPECTED_WIDTH@||result.height!==@EXPECTED_HEIGHT@||result.rgbaFnv1a64!=='@EXPECTED_PIXELS@')throw Error('Native/browser decoder parity differs: '+JSON.stringify(result));}finally{instance.exports.free(ptr);}return {status:'passed',scope:'dependency qualification only',admission,...result,imports,wasmSha256:'@WASM_SHA@',sourceSha256:'@SOURCE_SHA@',memoryBytes:instance.exports.memory.buffer.byteLength,timeOrigin:performance.timeOrigin};})()","timeoutMs":90000}
 ]
}
