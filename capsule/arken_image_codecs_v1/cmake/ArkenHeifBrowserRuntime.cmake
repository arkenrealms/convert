include_guard(GLOBAL)
function(arken_add_heif_browser_runtime)
  if(TARGET arken_image_heif_browser_runtime_v1)
    return()
  endif()
  if(NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "wasm32-unknown-emscripten")
    message(FATAL_ERROR "The HEIF browser runtime requires the admitted native Wasm toolchain")
  endif()
  get_filename_component(owner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
  add_library(arken_image_heif_browser_runtime_v1 STATIC "${owner}/browser/heif_memory_io.cpp")
  target_compile_features(arken_image_heif_browser_runtime_v1 PRIVATE cxx_std_20)
endfunction()
