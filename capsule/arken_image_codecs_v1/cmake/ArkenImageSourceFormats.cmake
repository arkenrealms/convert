include_guard(GLOBAL)
get_filename_component(image_source_owner "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
if(NOT TARGET arken_image_source_formats_v1)
    add_library(arken_image_source_formats_v1 INTERFACE)
    target_include_directories(arken_image_source_formats_v1 INTERFACE "${image_source_owner}/..")
    target_compile_features(arken_image_source_formats_v1 INTERFACE cxx_std_20)
endif()
function(arken_add_image_source_formats_tool)
    if(TARGET arken-image-source-formats)
        return()
    endif()
    get_filename_component(owner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    include("${owner}/../../sdk/arken_sdk_dev/cmake/ArkenPinnedNlohmannJson.cmake")
    arken_configure_pinned_nlohmann_json()
    add_executable(arken-image-source-formats EXCLUDE_FROM_ALL "${owner}/tools/source_formats.cpp")
    target_link_libraries(arken-image-source-formats PRIVATE arken_image_source_formats_v1 arken_nlohmann_json_header_only)
    set(output "${owner}/generated/source_formats.js")
    add_custom_command(OUTPUT "${output}" COMMAND arken-image-source-formats --output "${output}"
        DEPENDS arken-image-source-formats "${owner}/source_formats.hpp" VERBATIM)
    set(webp_recipe "${owner}/../../sdk/arken_sdk_dev/external_packages/recipes/libwebp-1.6.0-v1.json")
    set(webp_output "${owner}/generated/webp_sources.js")
    add_custom_command(OUTPUT "${webp_output}"
        COMMAND arken-image-source-formats --package-output "${webp_recipe}" "${webp_output}"
        DEPENDS arken-image-source-formats "${webp_recipe}" VERBATIM)
    add_custom_target(arken-image-source-formats-browser DEPENDS "${output}" "${webp_output}")
endfunction()

# Shared declaration for raw browser-module consumers as well as bundles.
function(arken_image_source_metadata_mappings out_mapping out_inputs)
    get_filename_component(owner "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/.." ABSOLUTE)
    set(mapping "")
    set(inputs)
    foreach(name source_formats.js webp_sources.js)
        string(APPEND mapping "${owner}/generated/${name}|capsules/arken_image_codecs_v1/generated/${name}\n")
        list(APPEND inputs "${owner}/generated/${name}")
    endforeach()
    set(${out_mapping} "${mapping}" PARENT_SCOPE)
    set(${out_inputs} "${inputs}" PARENT_SCOPE)
endfunction()
