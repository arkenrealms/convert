# Independent interoperability: an unrelated host decoder/encoder (FFmpeg) is
# used only as a reference oracle. Arken's WAV/FLAC/AIFF must decode to the
# exact PCM in FFmpeg, and FFmpeg's WAV/FLAC/AIFF/AIFF-C must decode to the
# exact PCM in Arken (or be rejected with the documented typed error).
# Usage: cmake -DTOOL=... -DFFMPEG=... -DWORK=... -P interop.cmake
foreach(required TOOL FFMPEG WORK)
  if(NOT DEFINED ${required})
    message(FATAL_ERROR "interop.cmake requires -D${required}")
  endif()
endforeach()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")
function(run)
  execute_process(COMMAND ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
  if(NOT code EQUAL 0)
    message(FATAL_ERROR "command failed (${code}): ${ARGN}\n${out}\n${err}")
  endif()
  if(NOT out STREQUAL "")
    message(STATUS "${out}")
  endif()
endfunction()
function(same left right what)
  file(SHA256 "${left}" a)
  file(SHA256 "${right}" b)
  if(NOT a STREQUAL b)
    message(FATAL_ERROR "${what}: ${left} and ${right} differ")
  endif()
  message(STATUS "${what}: identical PCM")
endfunction()
run("${TOOL}" --emit "${WORK}")
# name | raw format | codec | rate | channels | bits
foreach(spec "s16|s16le|pcm_s16le|44100|2|16" "s24|s24le|pcm_s24le|96000|2|24")
  string(REPLACE "|" ";" parts "${spec}")
  list(GET parts 0 name)
  list(GET parts 1 raw)
  list(GET parts 2 pcm)
  list(GET parts 3 rate)
  list(GET parts 4 channels)
  list(GET parts 5 bits)
  set(base "${WORK}/${name}")
  # Arken output -> FFmpeg decode.
  foreach(container wav flac)
    run("${FFMPEG}" -nostdin -v error -i "${base}.${container}" -f ${raw} -c:a ${pcm} "${base}.${container}.ffmpeg.raw")
    same("${base}.raw" "${base}.${container}.ffmpeg.raw" "FFmpeg decodes Arken ${name}.${container}")
  endforeach()
  # FFmpeg output -> Arken decode (FFmpeg adds LIST/INFO, SEEKTABLE, PADDING, tags).
  run("${FFMPEG}" -nostdin -v error -f ${raw} -ar ${rate} -ac ${channels} -i "${base}.raw" -c:a ${pcm} "${base}.ffmpeg.wav")
  run("${FFMPEG}" -nostdin -v error -f ${raw} -ar ${rate} -ac ${channels} -i "${base}.raw" -c:a flac "${base}.ffmpeg.flac")
  run("${TOOL}" --compare wav "${base}.ffmpeg.wav" "${base}.raw" ${rate} ${channels} ${bits})
  run("${TOOL}" --compare flac "${base}.ffmpeg.flac" "${base}.raw" ${rate} ${channels} ${bits})
endforeach()

# AIFF. name | raw format | raw codec | FFmpeg AIFF codec | rate | channels | bits
get_filename_component(ffmpeg_dir "${FFMPEG}" DIRECTORY)
find_program(FFPROBE ffprobe HINTS "${ffmpeg_dir}" NO_CACHE)
foreach(spec "s8|s8|pcm_s8|pcm_s8|22050|1|8" "s16|s16le|pcm_s16le|pcm_s16be|44100|2|16"
             "s24|s24le|pcm_s24le|pcm_s24be|96000|2|24" "s32|s32le|pcm_s32le|pcm_s32be|48000|2|32"
             "odd|s16le|pcm_s16le|pcm_s16be|11127|1|16")
  string(REPLACE "|" ";" parts "${spec}")
  list(GET parts 0 name)
  list(GET parts 1 raw)
  list(GET parts 2 pcm)
  list(GET parts 3 aiffpcm)
  list(GET parts 4 rate)
  list(GET parts 5 channels)
  list(GET parts 6 bits)
  set(base "${WORK}/${name}")
  # Arken AIFF -> FFmpeg's AIFF demuxer (forced with -f aiff).
  run("${FFMPEG}" -nostdin -v error -f aiff -i "${base}.aiff" -f ${raw} -c:a ${pcm} "${base}.aiff.ffmpeg.raw")
  same("${base}.raw" "${base}.aiff.ffmpeg.raw" "FFmpeg decodes Arken ${name}.aiff")
  if(FFPROBE)
    execute_process(COMMAND "${FFPROBE}" -v error -f aiff -show_entries stream=sample_rate,channels
      -of csv=p=0 "${base}.aiff" RESULT_VARIABLE code OUTPUT_VARIABLE probed OUTPUT_STRIP_TRAILING_WHITESPACE)
    if(NOT code EQUAL 0 OR NOT probed STREQUAL "${rate},${channels}")
      message(FATAL_ERROR "ffprobe reads ${name}.aiff as '${probed}', expected '${rate},${channels}'")
    endif()
    message(STATUS "ffprobe reads Arken ${name}.aiff as rate,channels ${probed}")
  endif()
  # FFmpeg FORM/AIFF (big-endian) -> Arken, which also checks rate/channels/bits.
  run("${FFMPEG}" -nostdin -v error -f ${raw} -ar ${rate} -ac ${channels} -i "${base}.raw" -c:a ${aiffpcm} -f aiff "${base}.ffmpeg.aiff")
  run("${TOOL}" --compare aiff "${base}.ffmpeg.aiff" "${base}.raw" ${rate} ${channels} ${bits})
endforeach()
# FFmpeg AIFF-C variants: 'sowt' little-endian 16-bit and 'raw ' unsigned 8-bit (both with FVER).
run("${FFMPEG}" -nostdin -v error -f s16le -ar 44100 -ac 2 -i "${WORK}/s16.raw" -c:a pcm_s16le -f aiff "${WORK}/s16.ffmpeg.sowt.aifc")
run("${TOOL}" --compare aiff "${WORK}/s16.ffmpeg.sowt.aifc" "${WORK}/s16.raw" 44100 2 16)
run("${FFMPEG}" -nostdin -v error -f s8 -ar 22050 -ac 1 -i "${WORK}/s8.raw" -c:a pcm_u8 -f aiff "${WORK}/s8.ffmpeg.raw.aifc")
run("${TOOL}" --compare aiff "${WORK}/s8.ffmpeg.raw.aifc" "${WORK}/s8.raw" 22050 1 8)
# FFmpeg AIFF-C that Arken must reject: float is never quantized; companded audio is unsupported.
foreach(spec "pcm_f32be|unsupported_float" "pcm_f64be|unsupported_float" "pcm_mulaw|unsupported_encoding" "pcm_alaw|unsupported_encoding")
  string(REPLACE "|" ";" parts "${spec}")
  list(GET parts 0 codec)
  list(GET parts 1 expected)
  run("${FFMPEG}" -nostdin -v error -f s16le -ar 44100 -ac 2 -i "${WORK}/s16.raw" -c:a ${codec} -f aiff "${WORK}/s16.${codec}.aifc")
  run("${TOOL}" --expect-aiff-error "${WORK}/s16.${codec}.aifc" ${expected})
endforeach()
