model conversion_request @type_id(1) {
 field source_path: text @field_id(1) { immutable true; }
 field output_path: text @field_id(2);
 field input_format: input_format @field_id(3);
 field output_format: output_format @field_id(4);
 field jpeg_quality: count @field_id(5) @optional { check minimum { kind minimum_integer; value "1"; } check maximum { kind maximum_integer; value "100"; } }
 field alpha_policy: alpha_policy @field_id(6) @optional;
 field webp_lossless: boolean @field_id(7) @optional;
 field webp_quality: count @field_id(8) @optional { check minimum { kind minimum_integer; value "1"; } check maximum { kind maximum_integer; value "100"; } }
 field tiff_deflate: boolean @field_id(9) @optional;
 key identity { kind primary; fields source_path; }
}
