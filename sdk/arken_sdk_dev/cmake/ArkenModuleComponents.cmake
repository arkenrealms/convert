include_guard(GLOBAL)

# Components are declared by the module owner, selected by one root composition.
# This is a view of the existing module graph, not another dependency registry.
function(_arken_component_view out_json out_entry manifest_json manifest_path)
    string(JSON _key GET "${manifest_json}" key)
    get_property(_selections GLOBAL PROPERTY ARKEN_GRAPH_COMPONENT_SELECTIONS)
    string(JSON _component ERROR_VARIABLE _error GET "${_selections}" "${_key}")
    if(NOT _error STREQUAL "NOTFOUND")
        set(${out_json} "${manifest_json}" PARENT_SCOPE)
        set(${out_entry} "" PARENT_SCOPE)
        return()
    endif()
    if(NOT _component MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Invalid component '${_component}' for '${_key}'")
    endif()
    string(JSON _view ERROR_VARIABLE _error GET "${manifest_json}" components "${_component}")
    if(NOT _error STREQUAL "NOTFOUND")
        message(FATAL_ERROR "Unknown component '${_component}' in '${manifest_path}'")
    endif()
    string(JSON _entry GET "${_view}" cmake)
    if(NOT _entry MATCHES "^[A-Za-z0-9_./-]+\\.cmake$" OR IS_ABSOLUTE "${_entry}"
       OR _entry MATCHES "(^|/)\\.\\.?(/|$)|//")
        message(FATAL_ERROR "Noncanonical component entrypoint '${_entry}' in '${manifest_path}'")
    endif()
    get_filename_component(_owner "${manifest_path}" DIRECTORY)
    if(NOT EXISTS "${_owner}/${_entry}" OR IS_DIRECTORY "${_owner}/${_entry}"
       OR IS_SYMLINK "${_owner}/${_entry}")
        message(FATAL_ERROR "Missing regular component entrypoint '${_owner}/${_entry}'")
    endif()
    file(REAL_PATH "${_owner}" _owner_real)
    file(REAL_PATH "${_owner}/${_entry}" _entry_real)
    cmake_path(IS_PREFIX _owner_real "${_entry_real}" NORMALIZE _contained)
    if(NOT _contained)
        message(FATAL_ERROR "Component entrypoint escapes module '${_key}': ${_entry}")
    endif()
    # Both dependency arrays are explicit, including an empty array.
    foreach(_field IN ITEMS public_dependencies private_dependencies)
        string(JSON _type TYPE "${_view}" "${_field}")
        if(NOT _type STREQUAL "ARRAY")
            message(FATAL_ERROR "Component '${_key}/${_component}' requires array ${_field}")
        endif()
    endforeach()
    string(JSON _view SET "${_view}" key "\"${_key}\"")
    set(${out_json} "${_view}" PARENT_SCOPE)
    set(${out_entry} "${_entry_real}" PARENT_SCOPE)
endfunction()

function(_arken_initialize_component_selection root_json)
    string(JSON _selections ERROR_VARIABLE _error GET "${root_json}" module_components)
    if(NOT _error STREQUAL "NOTFOUND")
        if(NOT _error MATCHES "member '.*' not found")
            message(FATAL_ERROR "Invalid module_components: ${_error}")
        endif()
        set(_selections "{}")
    endif()
    string(JSON _type TYPE "${_selections}")
    if(NOT _type STREQUAL "OBJECT")
        message(FATAL_ERROR "module_components must be an object")
    endif()
    set_property(GLOBAL PROPERTY ARKEN_GRAPH_COMPONENT_SELECTIONS "${_selections}")
endfunction()

function(_arken_validate_reached_components)
    get_property(_selections GLOBAL PROPERTY ARKEN_GRAPH_COMPONENT_SELECTIONS)
    get_property(_visited GLOBAL PROPERTY ARKEN_GRAPH_VISITED)
    string(JSON _count LENGTH "${_selections}")
    if(_count GREATER 0)
        math(EXPR _last "${_count} - 1")
        foreach(_index RANGE 0 ${_last})
            string(JSON _key MEMBER "${_selections}" ${_index})
            if(NOT _key IN_LIST _visited)
                message(FATAL_ERROR "Component selection targets an unreached module '${_key}'")
            endif()
        endforeach()
    endif()
endfunction()

# Narrow compositions may configure the graph without capsule/CMakeLists.txt's
# product-option expansion. External packages remain the caller's SDK boundary.
function(_arken_configure_component_entry entry)
    include("${entry}")
endfunction()

function(arken_add_resolved_module_targets)
    cmake_parse_arguments(ARG "" "BINARY_ROOT" "" ${ARGN})
    if(NOT ARG_BINARY_ROOT)
        message(FATAL_ERROR "arken_add_resolved_module_targets requires BINARY_ROOT")
    endif()
    get_property(_ordered GLOBAL PROPERTY ARKEN_GRAPH_VISITED)
    foreach(_key IN LISTS _ordered)
        string(MAKE_C_IDENTIFIER "${_key}" _ident)
        get_property(_manifest GLOBAL PROPERTY "ARKEN_MODULE_PATH_${_ident}")
        get_property(_entry GLOBAL PROPERTY "ARKEN_GRAPH_ENTRY_${_ident}")
        get_filename_component(_owner "${_manifest}" DIRECTORY)
        if(_entry STREQUAL "")
            set(_identity "${_owner}/CMakeLists.txt")
        else()
            get_property(_selections GLOBAL PROPERTY ARKEN_GRAPH_COMPONENT_SELECTIONS)
            string(JSON _component GET "${_selections}" "${_key}")
            set(_identity "${_entry} [${_component}]")
        endif()
        get_property(_configured GLOBAL PROPERTY "ARKEN_CONFIGURED_MODULE_ENTRY_${_ident}")
        if(_configured)
            if(NOT _configured STREQUAL _identity)
                message(FATAL_ERROR "Module '${_key}' already configured through '${_configured}', not '${_identity}'")
            endif()
            continue()
        endif()
        if(_entry STREQUAL "")
            add_subdirectory("${_owner}" "${ARG_BINARY_ROOT}/${_key}")
        else()
            _arken_configure_component_entry("${_entry}")
        endif()
        set_property(GLOBAL PROPERTY "ARKEN_CONFIGURED_MODULE_ENTRY_${_ident}" "${_identity}")
    endforeach()
endfunction()
