set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
set(CMAKE_C_COMPILER "@sdk_root@/bin/clang")
set(CMAKE_CXX_COMPILER "@sdk_root@/bin/clang++")
set(CMAKE_AR "@sdk_root@/bin/llvm-ar")
set(CMAKE_RANLIB "@sdk_root@/bin/llvm-ranlib")
set(CMAKE_STRIP "@sdk_root@/bin/llvm-strip")
set(CMAKE_NM "@sdk_root@/bin/llvm-nm")
set(CMAKE_C_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_CXX_COMPILER_TARGET wasm32-wasip1)
set(CMAKE_SYSROOT "@sdk_root@/share/wasi-sysroot")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(CMAKE_C_FLAGS_INIT "-fvisibility=hidden")
set(CMAKE_CXX_FLAGS_INIT "-fvisibility=hidden -fwasm-exceptions -mllvm -wasm-use-legacy-eh=false")
# Browser distribution is size-first. An explicit -O2 selection requires the
# consuming product's benchmark evidence; ambient CMake -O3 is not the policy.
set(ARKEN_BROWSER_CPP_RELEASE_OPTIMIZATION "-Oz" CACHE STRING "Qualified browser release optimization")
set_property(CACHE ARKEN_BROWSER_CPP_RELEASE_OPTIMIZATION PROPERTY STRINGS "-Oz" "-O2")
if(NOT ARKEN_BROWSER_CPP_RELEASE_OPTIMIZATION MATCHES "^-O(z|2)$")
    message(FATAL_ERROR "Browser release optimization must be -Oz or benchmark-qualified -O2")
endif()
set(ARKEN_BROWSER_CPP_RELEASE_LTO OFF CACHE BOOL "Enable ThinLTO for capability-qualified browser reactors")
set(_arken_browser_lto_compile "")
set(_arken_browser_lto_link "")
if(ARKEN_BROWSER_CPP_RELEASE_LTO)
    set(_arken_browser_lto_compile " -flto=thin")
    set(_arken_browser_lto_link "-flto=thin -Wl,--thinlto-jobs=2")
endif()
set(CMAKE_C_FLAGS_RELEASE "${ARKEN_BROWSER_CPP_RELEASE_OPTIMIZATION}${_arken_browser_lto_compile} -DNDEBUG" CACHE STRING "Browser release C flags" FORCE)
set(CMAKE_CXX_FLAGS_RELEASE "${ARKEN_BROWSER_CPP_RELEASE_OPTIMIZATION}${_arken_browser_lto_compile} -DNDEBUG" CACHE STRING "Browser release C++ flags" FORCE)
set(CMAKE_EXE_LINKER_FLAGS_RELEASE "${_arken_browser_lto_link}" CACHE STRING "Browser release link flags" FORCE)
set(CMAKE_EXE_LINKER_FLAGS_INIT "-fwasm-exceptions -lunwind -mexec-model=reactor")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(ARKEN_BROWSER_CPP ON CACHE BOOL "Native Clang browser reactor target")
