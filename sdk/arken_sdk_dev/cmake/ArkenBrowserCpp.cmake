include_guard(GLOBAL)
# Stable browser substrates use the native compiler and an explicitly imported
# browser capability surface. This does not compile authored LiveMachine programs.
function(arken_browser_cpp_reactor target)
    cmake_parse_arguments(ARG "NO_HOST_IO" "MAX_MEMORY_BYTES;STACK_BYTES" "EXPORT_FUNCTIONS" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "${target}: unknown or incomplete reactor profile arguments")
    endif()
    if(NOT ARKEN_BROWSER_CPP OR NOT CMAKE_CXX_COMPILER_TARGET STREQUAL "wasm32-wasip1")
        message(FATAL_ERROR "${target} requires the graph-owned native browser C++ toolchain")
    endif()
    if(NOT DEFINED ARG_MAX_MEMORY_BYTES)
        set(ARG_MAX_MEMORY_BYTES 268435456)
    endif()
    if(NOT ARG_MAX_MEMORY_BYTES MATCHES "^[1-9][0-9]*$"
       OR ARG_MAX_MEMORY_BYTES LESS 2097152 OR ARG_MAX_MEMORY_BYTES GREATER 2147483648)
        message(FATAL_ERROR "${target}: MAX_MEMORY_BYTES must be 2 MiB through 2 GiB")
    endif()
    math(EXPR memory_remainder "${ARG_MAX_MEMORY_BYTES} % 65536")
    if(NOT memory_remainder EQUAL 0)
        message(FATAL_ERROR "${target}: MAX_MEMORY_BYTES must be a whole Wasm page")
    endif()
    if(NOT DEFINED ARG_STACK_BYTES)
        set(ARG_STACK_BYTES 1048576)
    endif()
    if(NOT ARG_STACK_BYTES MATCHES "^[1-9][0-9]*$" OR ARG_STACK_BYTES LESS 65536
       OR ARG_STACK_BYTES GREATER 16777216 OR NOT ARG_STACK_BYTES LESS ARG_MAX_MEMORY_BYTES)
        message(FATAL_ERROR "${target}: STACK_BYTES must be 64 KiB through 16 MiB and below MAX_MEMORY_BYTES")
    endif()
    math(EXPR stack_remainder "${ARG_STACK_BYTES} % 65536")
    if(NOT stack_remainder EQUAL 0)
        message(FATAL_ERROR "${target}: STACK_BYTES must be a whole Wasm page")
    endif()
    set_property(TARGET ${target} PROPERTY ARKEN_BROWSER_CPP_STACK_BYTES "${ARG_STACK_BYTES}")
    set_property(TARGET ${target} PROPERTY ARKEN_BROWSER_CPP_MAX_MEMORY_BYTES "${ARG_MAX_MEMORY_BYTES}")
    if(ARG_NO_HOST_IO)
        target_sources(${target} PRIVATE
            "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/platform/wasm/closed_reactor.cpp")
        foreach(call environ_get environ_sizes_get clock_time_get poll_oneoff fd_close fd_seek fd_write
                fd_fdstat_get fd_fdstat_set_flags fd_prestat_get fd_prestat_dir_name fd_read path_open proc_exit)
            target_link_options(${target} PRIVATE "-Wl,--wrap=__wasi_${call}")
        endforeach()
    endif()
    set_target_properties(${target} PROPERTIES SUFFIX .wasm)
    if(DEFINED ARG_EXPORT_FUNCTIONS)
        # Restricted companions expose only their explicitly owned byte ABI.
        # Existing runtime consumers retain the established dynamic exports.
        foreach(symbol IN LISTS ARG_EXPORT_FUNCTIONS)
            if(NOT symbol MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
                message(FATAL_ERROR "${target}: invalid EXPORT_FUNCTIONS symbol ${symbol}")
            endif()
            target_link_options(${target} PRIVATE "-Wl,--export=${symbol}")
        endforeach()
    else()
        target_link_options(${target} PRIVATE -Wl,--export-dynamic -Wl,--export=malloc -Wl,--export=free)
    endif()
    target_link_options(${target} PRIVATE "-Wl,--max-memory=${ARG_MAX_MEMORY_BYTES}" "-Wl,-z,stack-size=${ARG_STACK_BYTES}")
endfunction()

# Native-compiled browser test entry shared by concrete capsule conformance
# consumers. Domain fixtures and acceptance stay in the consuming capsule.
function(arken_browser_cpp_conformance target)
    cmake_parse_arguments(ARG "C_MAIN" "MAX_MEMORY_BYTES;STACK_BYTES" "" ${ARGN})
    if(ARG_UNPARSED_ARGUMENTS OR ARG_KEYWORDS_MISSING_VALUES)
        message(FATAL_ERROR "${target}: unknown or incomplete conformance arguments")
    endif()
    target_sources(${target} PRIVATE
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/platform/wasm/tests/conformance_entry.cpp")
    target_compile_definitions(${target} PRIVATE main=arken_browser_cpp_conformance_main)
    if(ARG_C_MAIN)
        target_compile_definitions(${target} PRIVATE ARKEN_BROWSER_CPP_CONFORMANCE_C_MAIN=1)
    endif()
    target_compile_options(${target} PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-fexceptions>)
    include("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ArkenTestTerminalVersion.cmake")
    arken_test_terminal_version_support(${target})
    set(profile)
    if(DEFINED ARG_MAX_MEMORY_BYTES)
        list(APPEND profile MAX_MEMORY_BYTES "${ARG_MAX_MEMORY_BYTES}")
    endif()
    if(DEFINED ARG_STACK_BYTES)
        list(APPEND profile STACK_BYTES "${ARG_STACK_BYTES}")
    endif()
    arken_browser_cpp_reactor(${target} ${profile})
endfunction()

# Consumers exercise the SDK-owned denial contract without compiling private
# platform sources through a product-specific path.
function(arken_browser_cpp_closed_profile_probe target)
    add_executable(${target}
        "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../src/platform/wasm/tests/closed_reactor_probe.cpp")
    arken_browser_cpp_reactor(${target} NO_HOST_IO MAX_MEMORY_BYTES 2097152)
endfunction()
