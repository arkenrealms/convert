include_guard(GLOBAL)

# Project only the already resolved graph. This deliberately conservative
# attribution set is not a claim about the final linked/runtime closure.
function(arken_external_package_notice_assets)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;OUTPUT_ROOT" "")
    get_property(resolved GLOBAL PROPERTY ARKEN_EXTERNAL_PACKAGE_GRAPH_RESOLVED)
    if(NOT resolved OR NOT ARG_TARGET OR NOT IS_ABSOLUTE "${ARG_OUTPUT_ROOT}"
       OR ARG_UNPARSED_ARGUMENTS OR TARGET "${ARG_TARGET}")
        message(FATAL_ERROR "Package notices require a resolved graph, a new TARGET and absolute OUTPUT_ROOT")
    endif()
    get_property(recipes GLOBAL PROPERTY ARKEN_EXTPKG_RESOLVED)
    list(REMOVE_DUPLICATES recipes)
    list(SORT recipes)
    set(packages "")
    set(separator "")
    set(inputs)
    foreach(recipe IN LISTS recipes)
        _arken_extpkg_identifier(ident "${recipe}")
        get_property(json GLOBAL PROPERTY "ARKEN_EXTPKG_RECIPE_JSON_${ident}")
        get_property(root GLOBAL PROPERTY "ARKEN_EXTPKG_RECIPE_SOURCE_ROOT_${ident}")
        get_property(recipe_sha GLOBAL PROPERTY "ARKEN_EXTPKG_RECIPE_SHA_${ident}")
        string(JSON distribution GET "${json}" license distribution)
        if(distribution STREQUAL "system")
            continue()
        endif()
        if(NOT distribution STREQUAL "redistributable")
            message(FATAL_ERROR "Package notice publication rejects ${recipe}: ${distribution}")
        endif()
        if(NOT IS_DIRECTORY "${root}" OR NOT IS_ABSOLUTE "${root}")
            message(FATAL_ERROR "Resolved package source is unavailable for notices: ${recipe}")
        endif()
        string(JSON files GET "${json}" license files)
        string(JSON count LENGTH "${files}")
        if(count EQUAL 0)
            message(FATAL_ERROR "Redistributable package has no declared notices: ${recipe}")
        endif()
        foreach(field packageId upstreamVersion)
            string(JSON value GET "${json}" ${field})
            _arken_extpkg_json_escape(${field} "${value}")
        endforeach()
        string(JSON value GET "${json}" license spdx)
        _arken_extpkg_json_escape(spdx "${value}")
        _arken_extpkg_json_escape(source_root "${root}")
        string(APPEND packages "${separator}{\"recipeId\":\"${recipe}\",\"recipeSha256\":\"${recipe_sha}\",\"packageId\":\"${packageId}\",\"upstreamVersion\":\"${upstreamVersion}\",\"spdx\":\"${spdx}\",\"sourceRoot\":\"${source_root}\",\"files\":${files}}")
        set(separator ",\n")
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON path GET "${files}" ${index} path)
            list(APPEND inputs "${root}/${path}")
        endforeach()
    endforeach()
    set(private_root "${CMAKE_CURRENT_BINARY_DIR}/_arken/external-packages/notices/${ARG_TARGET}")
    set(plan "${private_root}/inputs.json")
    set(manifest "${private_root}/assets.manifest")
    _arken_extpkg_write_if_different("${plan}"
        "{\"schema\":\"arken.external-package-notice-inputs.v1\",\"packages\":[${packages}]}\n")
    set(stage_script "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/StageExternalPackageNotices.cmake")
    add_custom_target("${ARG_TARGET}"
        COMMAND "${CMAKE_COMMAND}" "-DINPUT=${plan}" "-DOUTPUT_ROOT=${ARG_OUTPUT_ROOT}"
            "-DMANIFEST=${manifest}" -P "${stage_script}"
        DEPENDS "${plan}" ${inputs} "${stage_script}"
        SOURCES "${stage_script}"
        BYPRODUCTS "${manifest}" "${ARG_OUTPUT_ROOT}/licenses/external-packages/index.json"
        VERBATIM)
    set_property(TARGET "${ARG_TARGET}" PROPERTY ARKEN_EXTERNAL_PACKAGE_NOTICE_MANIFEST "${manifest}")
endfunction()
