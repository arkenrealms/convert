include_guard(GLOBAL)

function(_arken_extpkg_patch_move out_result source destination)
    file(RENAME "${source}" "${destination}" RESULT _result)
    set(${out_result} "${_result}" PARENT_SCOPE)
endfunction()

function(_arken_extpkg_patch_validate_publication_paths package_root recipe_id)
    if(NOT IS_ABSOLUTE "${package_root}" OR NOT IS_DIRECTORY "${package_root}"
            OR IS_SYMLINK "${package_root}")
        _arken_extpkg_error("arken.external_packages.patch.publication_path_unsafe" "patch"
            "${recipe_id}" "Publication requires an existing non-symlink package directory.")
    endif()
    foreach(_name patched-source patched-source.receipt.json patched-source.lock)
        set(_path "${package_root}/${_name}")
        if(IS_SYMLINK "${_path}" OR
                (EXISTS "${_path}" AND
                 ((_name STREQUAL "patched-source" AND NOT IS_DIRECTORY "${_path}") OR
                  (NOT _name STREQUAL "patched-source" AND IS_DIRECTORY "${_path}"))))
            _arken_extpkg_error("arken.external_packages.patch.publication_path_unsafe" "patch"
                "${recipe_id}" "Publication path has an unsafe type: ${_path}")
        endif()
    endforeach()
endfunction()

# The caller holds the package lock throughout candidate construction and publication.
# Preserve unreceipted/invalid previous bytes until the verified candidate is accepted.
function(_arken_extpkg_publish_patched_source
        package_root temporary patched_tree receipt_json recipe_id nonce)
    set(_root "${package_root}/patched-source")
    set(_receipt "${package_root}/patched-source.receipt.json")
    set(_staged_receipt "${package_root}/patched-source.receipt.partial-${nonce}.json")
    set(_quarantine "${package_root}/patched-source.quarantine-${nonce}")
    _arken_extpkg_patch_validate_publication_paths("${package_root}" "${recipe_id}")
    if(EXISTS "${_staged_receipt}" OR IS_SYMLINK "${_staged_receipt}"
            OR EXISTS "${_quarantine}" OR IS_SYMLINK "${_quarantine}")
        _arken_extpkg_error("arken.external_packages.patch.publication_path_unsafe" "patch"
            "${recipe_id}" "Publication staging identity already exists; previous bytes were preserved.")
    endif()
    # A write failure here cannot change the previous source or receipt.
    file(WRITE "${_staged_receipt}" "${receipt_json}")
    set(_reuse_source FALSE)
    if(EXISTS "${_root}")
        _arken_extpkg_tree_identity(_previous_tree "${_root}" "${recipe_id}")
        if("${_previous_tree}" STREQUAL "${patched_tree}")
            set(_reuse_source TRUE)
        endif()
    endif()
    set(_source_preserved FALSE)
    set(_receipt_preserved FALSE)
    set(_source_published FALSE)
    set(_result "0")
    if((EXISTS "${_root}" AND NOT _reuse_source) OR EXISTS "${_receipt}")
        file(MAKE_DIRECTORY "${_quarantine}")
    endif()
    if(EXISTS "${_root}" AND NOT _reuse_source)
        _arken_extpkg_patch_move(_result "${_root}" "${_quarantine}/source")
        if(_result STREQUAL "0")
            set(_source_preserved TRUE)
        endif()
    endif()
    if(_result STREQUAL "0" AND EXISTS "${_receipt}")
        _arken_extpkg_patch_move(_result "${_receipt}" "${_quarantine}/receipt.json")
        if(_result STREQUAL "0")
            set(_receipt_preserved TRUE)
        endif()
    endif()
    if(_result STREQUAL "0" AND NOT _reuse_source)
        _arken_extpkg_patch_move(_result "${temporary}" "${_root}")
        if(_result STREQUAL "0")
            set(_source_published TRUE)
        endif()
    endif()
    if(_result STREQUAL "0")
        _arken_extpkg_patch_move(_result "${_staged_receipt}" "${_receipt}")
    endif()
    if(NOT _result STREQUAL "0")
        set(_failure "${_result}")
        # Move the new tree back to its unique candidate path before restoring the old tree.
        if(_source_published)
            _arken_extpkg_patch_move(_rollback "${_root}" "${temporary}")
            if(NOT _rollback STREQUAL "0")
                _arken_extpkg_error("arken.external_packages.patch.rollback_failed" "patch" "${recipe_id}"
                    "Publication failed (${_failure}); candidate withdrawal failed (${_rollback}). Preserved state: ${_quarantine}")
            endif()
        endif()
        foreach(_kind source receipt)
            if(_${_kind}_preserved)
                if(_kind STREQUAL "source")
                    set(_from "${_quarantine}/source")
                    set(_to "${_root}")
                else()
                    set(_from "${_quarantine}/receipt.json")
                    set(_to "${_receipt}")
                endif()
                _arken_extpkg_patch_move(_rollback "${_from}" "${_to}")
                if(NOT _rollback STREQUAL "0")
                    _arken_extpkg_error("arken.external_packages.patch.rollback_failed" "patch" "${recipe_id}"
                        "Publication failed (${_failure}); ${_kind} restoration failed (${_rollback}). Preserved state: ${_quarantine}")
                endif()
            endif()
        endforeach()
        _arken_extpkg_error("arken.external_packages.patch.publish_failed" "patch" "${recipe_id}"
            "Patched source publication failed: ${_failure}. Previous source and receipt restored; candidate retained: ${temporary}")
    endif()
    if(_reuse_source)
        # Only this invocation's verified redundant candidate is disposable.
        file(REMOVE_RECURSE "${temporary}")
    endif()
    if(_source_preserved OR _receipt_preserved)
        message(STATUS "Arken external package ${recipe_id}: prior publication preserved at ${_quarantine}")
    endif()
endfunction()
